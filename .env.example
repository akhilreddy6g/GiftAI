# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Docker Compose sets DATABASE_URL itself, so locally you only need .env to run outside Docker.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# text (readable, for local use) | json (one object per line, for hosted logs)
LOG_FORMAT=text

# Any Postgres 15+ with pgvector 0.7+. Aiven's URL can be pasted unchanged, sslmode included.
DATABASE_URL=postgresql://giftai:giftai@localhost:5432/giftai
# Aiven's free plan allows 20 connections in total; keep pool size + overflow well below it.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:4200
