# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Docker Compose reads it too, and overrides DATABASE_URL to use its own local database.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# text (readable, for local use) | json (one object per line, for hosted logs)
LOG_FORMAT=text

# Any Postgres 15+ with pgvector 0.8+. Aiven's URL can be pasted unchanged, sslmode included.
DATABASE_URL=postgresql://giftai:giftai@localhost:5432/giftai
# Aiven's free plan allows 20 connections in total; keep pool size + overflow well below it.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Supabase project URL (Project Settings > API). The API checks sign-in tokens against
# this project's public signing keys, so no Supabase secret is needed.
SUPABASE_URL=https://your-project-ref.supabase.co
# Public (anon / publishable) key. Only scripts/get_access_token.py and the frontend use it.
SUPABASE_ANON_KEY=your-publishable-key

# Product search embeddings. Must be the model that embedded the catalog. The Docker image
# bakes the model in; outside Docker it downloads (about 70 MB) on the first search.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Optional: where the model is cached (default: fastembed's cache folder).
# EMBEDDING_CACHE_DIR=

# The gift agent's LLMs (also used to draft the rulebook). Gemini answers first; Groq takes
# over when Gemini is busy. Free keys: https://aistudio.google.com/apikey and
# https://console.groq.com/keys. With neither set, the agent says it is switched off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Each user's share of the free LLM quota, in agent replies per day.
AGENT_TURNS_PER_USER_PER_DAY=40

# Abuse protection
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=65536

# Host port for the API under Docker Compose (change it if 8000 is taken on your machine).
BACKEND_PORT=8000
